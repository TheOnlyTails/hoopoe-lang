import std/io with (println)
import std/fs with (Path, read_text)

func count_words(text: string) = text.replace("\n", " ").split(" ").iter().map((word) -> word.trim().to_lower()).filter((word) -> !word.is_empty()).fold(
	#{},
	(
		counts: #{string: int},
		word,
	) -> counts.inserted(
		word,
		(counts.get(word) ?? 0) + 1,
	),
)

func print_top(counts: #{string: int}) = {
	let top = counts.entries().iter().sorted_by((left, right) -> right[1].compare_to(left[1])).take(5u)

	println("most common words:")
	for (#(word, count) in top) println("  ${count}  ${word}")
}

async func main() = {
	let text = read_text(Path.from_string("poem.txt")).await?
	print_top(count_words(text))
	Ok(value = #())
}
