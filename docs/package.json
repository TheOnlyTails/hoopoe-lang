{
	"name": "hoopoe-docs",
	"private": true,
	"homepage": "https://hoopoelang.dev/",
	"repository": {
		"type": "git",
		"url": "https://github.com/theonlytails/hoopoe_lang.git",
		"directory": "docs"
	},
	"type": "module",
	"scripts": {
		"build:wasm": "wasm-pack build ../crates/hoopoe-wasm --target web --out-dir ../../docs/.vitepress/wasm --out-name hoopoe_wasm",
		"predev": "pnpm build:wasm --dev",
		"dev": "vitepress dev",
		"prebuild": "pnpm build:wasm",
		"build": "vitepress build",
		"test": "node --test tests/*.test.mjs",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "vitepress preview"
	},
	"devDependencies": {
		"markdown-it-mathjax3": "^5.2.0",
		"vitepress": "2.0.0-alpha.20",
		"vue": "^3.5.40",
		"wasm-pack": "^0.15.0",
		"wrangler": "4.129.0"
	}
}
