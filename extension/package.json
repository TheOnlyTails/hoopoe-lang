{
	"name": "hoopoe",
	"displayName": "Hoopoe",
	"version": "0.0.1",
	"description": "Support for the Hoopoe programming language",
	"categories": [
		"Programming Languages"
	],
	"homepage": "https://hoopoelang.dev/",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/theonlytails/hoopoe_lang.git",
		"directory": "extension"
	},
	"publisher": "theonlytails",
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle",
		"compile": "tsc -p ./",
		"bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
		"watch": "tsc -watch -p ./",
		"test": "pnpm run compile && node --test test/*.test.cjs && pnpm run test:configuration && pnpm run test:smoke",
		"test:configuration": "node --test out/test/languageConfiguration.test.js",
		"test:docs": "node scripts/check-docs.cjs",
		"test:smoke": "node out/test/runTest.js",
		"test:unit": "pnpm run compile && node --test test/*.test.cjs",
		"stage:server": "node scripts/stage-server.cjs",
		"verify:vsix": "node scripts/verify-vsix.cjs",
		"package:target": "vsce package --no-dependencies",
		"deploy": "vsce publish"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/vscode": "1.100.0",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"jsonc-parser": "^3.3.1",
		"typescript": "^7.0.2"
	},
	"contributes": {
		"configuration": {
			"title": "Hoopoe",
			"properties": {
				"hoopoe.server.path": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Development-only absolute path override for hoopoe-lsp. Published packages use their bundled server by default."
				},
				"hoopoe.buildProfile": {
					"type": "string",
					"enum": [
						"development",
						"release"
					],
					"default": "development",
					"scope": "window",
					"description": "Select the compiler profile used for workspace diagnostics."
				}
			}
		},
		"languages": [
			{
				"id": "hoopoe",
				"aliases": [
					"Hoopoe",
					"hoopoe"
				],
				"extensions": [
					".hoo"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "hoopoe",
				"path": "./snippets/hoopoe.json"
			}
		],
		"grammars": [
			{
				"language": "hoopoe",
				"scopeName": "source.hoopoe",
				"path": "./syntaxes/hoopoe.tmLanguage.json"
			},
			{
				"scopeName": "markdown.hoopoe.codeblock",
				"path": "./syntaxes/hoopoe.codeblock.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.hoopoe": "hoopoe"
				}
			}
		]
	},
	"preview": true,
	"engines": {
		"vscode": "^1.100.0"
	}
}
